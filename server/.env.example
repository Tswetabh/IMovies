# Server
PORT=5000
NODE_ENV=development

# Database - MongoDB Atlas connection string or local mongod
MONGO_URI=mongodb://127.0.0.1:27017/imovies
# Only set this when your network blocks SRV lookups, e.g. 8.8.8.8,1.1.1.1
MONGO_DNS_SERVERS=

# Auth - use a long random string, never commit the real value
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public URL of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

# Seeded admin account (created by `npm run seed`)
ADMIN_NAME=IMovies Admin
ADMIN_EMAIL=admin@imovies.test
ADMIN_PASSWORD=Admin@12345
